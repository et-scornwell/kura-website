---
---

<footer class="footer">
  <div class="container footer-inner">
    <a href="#top" class="footer-logo" aria-label="Kura Holdings home">
      <img src="/logos/kura-full-light.svg" alt="Kura Holdings" width="160" height="26" />
    </a>
    <nav class="footer-nav" aria-label="Site sections">
      <a href="#about">About</a>
      <a href="#criteria">Criteria</a>
      <a href="#team">Team</a>
      <a href="#approach">Approach</a>
      <a href="#contact">Contact</a>
    </nav>
    <p class="footer-copyright small">© 2026 Kura Holdings. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    color: var(--text);
    padding-block: 3rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-logo img {
    height: 26px;
    width: auto;
  }

  .footer-nav {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer-nav a {
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .footer-nav a:hover {
    color: #fff;
  }

  .footer-copyright {
    margin: 0;
    text-align: right;
    color: var(--text-muted);
  }

  @media (max-width: 760px) {
    .footer-inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 1.25rem;
    }

    .footer-logo {
      justify-self: center;
    }

    .footer-copyright {
      text-align: center;
    }
  }
</style>
