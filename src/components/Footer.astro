---
---

<footer class="footer">
  <div class="container footer-inner">
    <a href="#top" class="footer-logo" aria-label="Kura Holdings home">
      <img src="/logos/kura-full-light.svg" alt="Kura Holdings" width="160" height="26" />
    </a>
    <p class="footer-copyright small">© 2026 Kura Holdings. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    color: var(--text);
    padding-block: 3rem;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .footer-logo img {
    height: 26px;
    width: auto;
  }

  .footer-copyright {
    margin: 0;
    text-align: right;
    color: var(--text-muted);
  }

  @media (max-width: 760px) {
    .footer-inner {
      flex-direction: column;
      text-align: center;
      gap: 1.25rem;
    }

    .footer-copyright {
      text-align: center;
    }
  }
</style>
