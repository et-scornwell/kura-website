---
const navLinks = [
  { href: "#about", label: "About" },
  { href: "#criteria", label: "Criteria" },
  { href: "#team", label: "Team" },
  { href: "#approach", label: "Approach" },
];
---

<header class="topbar">
  <div class="container topbar-inner">
    <a href="#top" class="topbar-logo" aria-label="Kura Holdings home">
      <img src="/logos/kura-full-light.svg" alt="Kura Holdings" width="160" height="26" />
    </a>
    <nav class="topbar-nav" aria-label="Primary">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <a href="#contact" class="topbar-cta">Get in Touch</a>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(2, 48, 71, 0.82);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 68px;
  }

  .topbar-logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .topbar-logo img {
    height: 26px;
    width: auto;
  }

  .topbar-nav {
    display: flex;
    gap: 1.75rem;
    margin-left: auto;
  }

  .topbar-nav a {
    color: var(--text);
    font-weight: 500;
    font-size: 0.95rem;
    opacity: 0.85;
    transition: opacity 0.15s ease, color 0.15s ease;
  }

  .topbar-nav a:hover {
    color: var(--sky);
    opacity: 1;
  }

  .topbar-cta {
    display: inline-block;
    background: var(--ember);
    color: var(--text);
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius-sm);
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .topbar-cta:hover {
    background: var(--sun);
    color: var(--text);
    transform: translateY(-1px);
  }

  @media (max-width: 760px) {
    .topbar-nav {
      display: none;
    }

    .topbar-cta {
      margin-left: auto;
    }
  }
</style>
