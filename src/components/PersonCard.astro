---
interface Props {
  name: string;
  initials: string;
  title: string;
  bio: string[];
}

const { name, initials, title, bio } = Astro.props;
---

<article class="person">
  <div class="person-photo" aria-hidden="true">
    <span>{initials}</span>
  </div>
  <h3 class="person-name">{name}</h3>
  <p class="person-title small muted">{title}</p>
  {bio.map((paragraph) => <p>{paragraph}</p>)}
</article>

<style>
  .person {
    display: flex;
    flex-direction: column;
  }

  .person-photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--steel), var(--sky));
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }

  .person-name {
    margin-bottom: 0.15rem;
  }

  .person-title {
    margin-bottom: 1rem;
  }

  .person p {
    max-width: none;
  }
</style>
