  .criteria-list li {
    padding: 0.7rem 0 0.7rem 1.75rem;
    position: relative;
    border-bottom: 1px solid var(--border);
  }

  .criteria-list li:last-child {
    border-bottom: none;
  }

  .criteria-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.15rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ember);
  }
</style>
